rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Доступ только у членов семьи. Впишите сюда Google-почты всех, кто пользуется сайтом.
    function isFamily() {
      return request.auth != null
        && request.auth.token.email in ['you@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if isFamily();
    }
  }
}
